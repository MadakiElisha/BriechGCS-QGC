# /etc/briech/edge-<tower-id>.env: the edge pipeline's options on that tower's Jetson.
# The MQTT password, device token and CA are read from their usual places under
# /opt/briech/ops/ (copied from the ground server; see ops/README.md).
EDGE_ARGS=--camera csi:0 --host ground.lan --snapshot-url https://ground.lan:8443/api/v1/snapshots
