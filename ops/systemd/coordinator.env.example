# /etc/briech/coordinator.env: the coordinator's settings on the ground server.
# Secrets are named by file (..._FILE), never written here.
BRIECH_MQTT_HOST=localhost
BRIECH_MQTT_CA=/opt/briech/ops/certs/ca.crt
BRIECH_MQTT_PASSWORD_FILE=/opt/briech/ops/secrets/mqtt/coordinator.password
BRIECH_TLS_CERT=/opt/briech/ops/certs/server.crt
BRIECH_TLS_KEY=/opt/briech/ops/certs/server.key
BRIECH_OPERATOR_TOKENS_FILE=/opt/briech/ops/secrets/operator.tokens
BRIECH_DEVICE_TOKENS_FILE=/opt/briech/ops/secrets/device.tokens
