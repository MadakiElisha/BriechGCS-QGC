{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.briech.invalid/v1/snapshot.schema.json",
  "title": "snapshot, version 1",
  "description": "Coordinator to QGC, once per connection right after hello: the whole current picture. Only changes follow. The one message allowed over 4 KB.",
  "allOf": [{ "$ref": "envelope.schema.json" }],
  "properties": {
    "type": { "const": "snapshot" },
    "data": {
      "type": "object",
      "required": ["assets", "vehicles", "objects", "alerts"],
      "properties": {
        "assets": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/asset" } },
        "vehicles": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/vehicle" } },
        "objects": { "type": "array", "maxItems": 500, "items": { "$ref": "common.schema.json#/$defs/object" } },
        "alerts": { "type": "array", "maxItems": 100, "items": { "$ref": "common.schema.json#/$defs/alert" } }
      }
    }
  }
}
