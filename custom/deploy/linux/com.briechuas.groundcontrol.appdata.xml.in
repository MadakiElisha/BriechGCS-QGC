<?xml version="1.0" encoding="UTF-8"?>
<!--
  Briech UAS AppStream metadata for the Linux AppImage.

  custom/cmake/CustomOverrides.cmake points QGC_APPIMAGE_METADATA_PATH here,
  so the stock deploy/linux/org.mavlink.qgroundcontrol.appdata.xml.in is no
  longer used and stays untouched.

  The stock file lists a screenshot on docs.qgroundcontrol.com that no longer
  exists. appimagetool validates this file with appstreamcli, which treats the
  dead link as a warning and fails the build. This copy has no <screenshots>
  block. Add one only with an image URL that is already live (for example a
  file on main in this repository); a link that 404s fails the build again.
-->
<component type="desktop-application">
  <id>@QGC_PACKAGE_NAME@</id>
  <name>@QGC_APP_NAME@</name>
  <launchable type="desktop-id">@QGC_PACKAGE_NAME@.desktop</launchable>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0 OR GPL-3.0</project_license>
  <content_rating type="oars-1.1"/>

  <summary>@QGC_APP_DESCRIPTION@</summary>
  <description>
    <p>
      Briech UAS is a modern Ground Control Station for MAVLink-enabled unmanned aircraft.
      It provides mission planning, flight monitoring, vehicle setup, telemetry, maps,
      and operational tools in a Briech-branded command interface.
    </p>
  </description>
  <icon type="stock">@QGC_APP_NAME@</icon>

  <provides>
    <binary>@QGC_APP_NAME@</binary>
  </provides>

  <releases>
    <release version="@CMAKE_PROJECT_VERSION@" date="@QGC_APP_DATE@">
      <description>
        <p>Briech UAS build based on QGroundControl.</p>
      </description>
    </release>
  </releases>

  <url type="homepage">https://@QGC_ORG_DOMAIN@</url>
  <url type="help">https://@QGC_ORG_DOMAIN@</url>
  <url type="bugtracker">https://@QGC_ORG_DOMAIN@</url>
  <url type="contact">https://@QGC_ORG_DOMAIN@</url>

  <requires>
    <display_length>360</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
    <control>gamepad</control>
  </supports>

  <categories>
    <category>Qt</category>
    <category>Utility</category>
    <category>Maps</category>
  </categories>

  <keywords>
    <keyword translate="no">mavlink</keyword>
    <keyword translate="no">qt</keyword>
    <keyword>drone</keyword>
    <keyword translate="no">ardupilot</keyword>
    <keyword translate="no">pixhawk</keyword>
  </keywords>
</component>
